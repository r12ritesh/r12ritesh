<mvc:View controllerName="com.sap.project.learn.projectlearn.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
    <content>

    <Text id="idTxWlcome" text="Welcome to SAP UI5" textAlign= "Center" width="100%" class= "sapMH1FontSize"></Text>
    <!-- <Text text="This is a basic UI5 element" textAlign= "Center" width="100%" class= "owntextfontsize"></Text> -->
    <Text text = "1. Text || 2. Label || 3.Input Field || 4.Button" width= "100%" class="sapUiSmallMarginBottom"/> 


    <Label id="idLabel" text="Enter your name" required= "true" class= "sapUiSmallMarginBegin" ></Label>
    <Input id="idIpname" width= "30%" maxLength= "10" value="Ritesh" class="sapUiTinyMarginBegin" ></Input>

    <Button id= "idSubmit" text="Submit" type= "Emphasized" class= " sapUiTinyMarginBegin" press="onSubmitPress"></Button>

    <VBox >
    <Button text="1. Grid Layout" type="Emphasized" class="sapUiTinyMarginBegin" press= "onPressBtn"/>
    <Button text ="2. Simple Form Layout" type= "Emphasized" class= "sapUiTinyMarginBegin" press="onPressBtnSimpleForm"/>
    <Button text ="3. ObjectHeader and IconTabBar" type= "Emphasized" class= "sapUiTinyMarginBegin" press="onPressBtnObjHeadrIcnTbBar"/>
    
    </VBox>
    </content>
    <footer>
     <Bar>
        <contentRight>
            <Button text ="Grid Layout" type= "Emphasized" press="onPressBtn"/>
            <Button text ="Simple Form Layout" type= "Emphasized" press="onPressBtnSimpleForm"/>
        </contentRight>
     </Bar>
    </footer>
    </Page>
</mvc:View>