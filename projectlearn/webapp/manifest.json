{
  "_version": "1.65.0",
  "sap.app": {
    "id": "com.sap.project.learn.projectlearn",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.18.3",
      "toolsId": "06cc8d20-9484-4781-a714-e5d87b2d5238"
    },
    "dataSources": {
      "mainService": {
        "uri": "/V2/northwind/Northwind.svc/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.138.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.sap.project.learn.projectlearn.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.sap.project.learn.projectlearn.view",
        "async": true,
        "viewPath": "com.sap.project.learn.projectlearn.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": "",
          "target": [
            "TargetView1"
          ]
        },
        {
          "name": "RouteView2",
          "pattern": "Second View",
          "target": [
            "TargetView2"
          ]
        },
        {
          "name": "RouteFormLayout",
          "pattern": "Third View",
          "target": [
            "TargetFormLayout"
          ]
        },
        {
          "name": "RouteView4",
          "pattern": "Fourth View",
          "target": [
            "TargetView4"
          ]
        },
        {
          "name": "RouteView5",
          "pattern": "Fifth View",
          "target": [
            "TargetView5"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        },
        "TargetView2": {
          "id": "View2",
          "name": "View2"
        },
        "TargetFormLayout": {
          "id": "FormLayout",
          "name": "FormLayout"
        },
        "TargetView4": {
          "id": "View4",
          "name": "View4"
        },
        "TargetView5": {
          "id": "View5",
          "name": "CRUDQ"
        }
      }
    },
    "rootView": {
      "viewName": "com.sap.project.learn.projectlearn.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
